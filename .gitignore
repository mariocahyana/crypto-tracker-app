*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# --- OS ---
.DS_Store
Thumbs.db

# --- Android generated ---
/captures
.externalNativeBuild
.cxx
*.apk
*.ap_
*.aab

# --- Kotlin ---
.kotlin/

# --- Secrets / API Keys ---
secrets.properties
apikeys.properties
google-services.json
