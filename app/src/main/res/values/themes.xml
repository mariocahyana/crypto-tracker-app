<resources>
    <!--
        Base application theme for the Compose app.
        Uses AppCompat NoActionBar as the XML parent — all visual theming
        is handled by CryptoPortfolioTheme in Kotlin/Compose.
        Note: Theme.Material3 XML requires the 'com.google.android.material:material'
        artifact with XML styles, which we don't use in a pure-Compose app.
    -->
    <style name="Theme.GameStoreHB" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/crypto_background</item>
    </style>
</resources>